<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== 文字与控件配色：白色玻璃主题（保持 V2.5 原值） ========== -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827"/>
    <SolidColorBrush x:Key="TextValueBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#5C6B80"/>

    <SolidColorBrush x:Key="CardBorderBrush" Color="#26000000"/>
    <SolidColorBrush x:Key="CardHoverBgBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="ChildBorderBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="ChildBgBrush" Color="#0FFFFFFF"/>

    <SolidColorBrush x:Key="BarTrackBrush" Color="#3DFFFFFF"/>
    <LinearGradientBrush x:Key="BarFillBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#5B7A99" Offset="0"/>
        <GradientStop Color="#7FA3C4" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ScanBtnBgBrush" Color="#4DFFFFFF"/>
    <SolidColorBrush x:Key="ScanBtnHoverBrush" Color="#73FFFFFF"/>
    <SolidColorBrush x:Key="ScanBtnPressBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="ScanBtnBorderBrush" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="ScanBtnFgBrush" Color="#111827"/>

    <SolidColorBrush x:Key="StatusDotIdleBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="StatusDotBusyBrush" Color="#3B82F6"/>

    <!-- ========== 玻璃材质层（V2.5 原样） ========== -->
    <SolidColorBrush x:Key="GlassPanelBrush" Color="#F7FAFC" Opacity="0.55"/>
    <LinearGradientBrush x:Key="GlassEdgeOuterBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2FFFFFF" Offset="0"/>
        <GradientStop Color="#59FFFFFF" Offset="0.5"/>
        <GradientStop Color="#CCFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassEdgeInnerBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#26FFFFFF" Offset="0"/>
        <GradientStop Color="#8CFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassVeilBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#33FFFFFF" Offset="0"/>
        <GradientStop Color="#0DFFFFFF" Offset="0.35"/>
        <GradientStop Color="#0AFFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ========== 金属材质层：玻璃主题下不显示（可见性由代码控制），此处定义占位避免引用失败 ========== -->
    <LinearGradientBrush x:Key="MetalBaseBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A1D22" Offset="0"/>
        <GradientStop Color="#23272F" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="MetalVignetteBrush" GradientOrigin="0.5,0.38" Center="0.5,0.38"
                         RadiusX="0.75" RadiusY="0.8">
        <GradientStop Color="#9E0B0D10" Offset="0"/>
        <GradientStop Color="#000B0D10" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="ReflectWarmBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#38F2C08A" Offset="0"/>
        <GradientStop Color="#00F2C08A" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="ReflectCoolBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#2B7FA6C9" Offset="0"/>
        <GradientStop Color="#007FA6C9" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="ReflectStripBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="#1CFFFFFF" Offset="0.5"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MetalEdgeOuterBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#59FFFFFF" Offset="0"/>
        <GradientStop Color="#1AFFFFFF" Offset="0.5"/>
        <GradientStop Color="#3DFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MetalEdgeInnerBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#26FFFFFF" Offset="0"/>
        <GradientStop Color="#12000000" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
