<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== 文字与控件配色：深色金属主题 ========== -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8ECF2"/>
    <SolidColorBrush x:Key="TextValueBrush" Color="#D6DCE6"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B96A6"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7686"/>
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#8B96A6"/>

    <SolidColorBrush x:Key="CardBorderBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBgBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="ChildBorderBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="ChildBgBrush" Color="#0AFFFFFF"/>

    <SolidColorBrush x:Key="BarTrackBrush" Color="#26FFFFFF"/>
    <LinearGradientBrush x:Key="BarFillBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#8FA8C4" Offset="0"/>
        <GradientStop Color="#B9CBDD" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ScanBtnBgBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="ScanBtnHoverBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="ScanBtnPressBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="ScanBtnBorderBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="ScanBtnFgBrush" Color="#E8ECF2"/>

    <SolidColorBrush x:Key="StatusDotIdleBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="StatusDotBusyBrush" Color="#60A5FA"/>

    <!-- ========== 金属材质层 ========== -->
    <!-- 主体：深枪灰对角渐变，96% 不透明（保留极轻背景透感，不做死黑矩形） -->
    <LinearGradientBrush x:Key="MetalBaseBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F51A1D22" Offset="0"/>
        <GradientStop Color="#F523272F" Offset="1"/>
    </LinearGradientBrush>

    <!-- 中央暗区：制造凹面纵深，中央更暗 -->
    <RadialGradientBrush x:Key="MetalVignetteBrush" GradientOrigin="0.5,0.38" Center="0.5,0.38"
                         RadiusX="0.75" RadiusY="0.8">
        <GradientStop Color="#9E0B0D10" Offset="0"/>
        <GradientStop Color="#000B0D10" Offset="1"/>
    </RadialGradientBrush>

    <!-- 反射光源：暖琥珀球 / 冷蓝板面 / 白色灯条（边缘全透明，视觉等效模糊） -->
    <RadialGradientBrush x:Key="ReflectWarmBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#38F2C08A" Offset="0"/>
        <GradientStop Color="#1FF2C08A" Offset="0.45"/>
        <GradientStop Color="#00F2C08A" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="ReflectCoolBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                         RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#2B7FA6C9" Offset="0"/>
        <GradientStop Color="#147FA6C9" Offset="0.5"/>
        <GradientStop Color="#007FA6C9" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="ReflectStripBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="#12FFFFFF" Offset="0.5"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- 倒角：外缘亮暗不均，内缘反向（形成内斜面） -->
    <LinearGradientBrush x:Key="MetalEdgeOuterBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#59FFFFFF" Offset="0"/>
        <GradientStop Color="#1AFFFFFF" Offset="0.5"/>
        <GradientStop Color="#3DFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MetalEdgeInnerBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#26FFFFFF" Offset="0"/>
        <GradientStop Color="#12000000" Offset="1"/>
    </LinearGradientBrush>

    <!-- ========== 玻璃材质层：金属主题下不显示，保留定义避免引用失败 ========== -->
    <SolidColorBrush x:Key="GlassPanelBrush" Color="#F7FAFC" Opacity="0.55"/>
    <LinearGradientBrush x:Key="GlassEdgeOuterBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2FFFFFF" Offset="0"/>
        <GradientStop Color="#59FFFFFF" Offset="0.5"/>
        <GradientStop Color="#CCFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassEdgeInnerBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#26FFFFFF" Offset="0"/>
        <GradientStop Color="#8CFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassVeilBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#33FFFFFF" Offset="0"/>
        <GradientStop Color="#0DFFFFFF" Offset="0.35"/>
        <GradientStop Color="#0AFFFFFF" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
