<Window x:Class="ProcessPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProcessPanel"
        Title="进程助手" Height="460" Width="330"
        WindowStyle="None" ResizeMode="NoResize" Topmost="False"
        AllowsTransparency="True"
        ShowInTaskbar="False" Background="Transparent"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="TopMostMenu" Header="置顶显示（始终可见）" IsCheckable="True" Click="ToggleTopMost_Click"/>
            <MenuItem Header="切换材质（液态玻璃 / 白玻璃）" Click="ToggleTheme_Click"/>
            <MenuItem Header="材质透明度">
                <MenuItem x:Name="Alpha96" Header="96%　最实" IsCheckable="True" Tag="0.96" Click="SetAlpha_Click"/>
                <MenuItem x:Name="Alpha88" Header="88%" IsCheckable="True" Tag="0.88" Click="SetAlpha_Click"/>
                <MenuItem x:Name="Alpha80" Header="80%" IsCheckable="True" Tag="0.80" Click="SetAlpha_Click"/>
                <MenuItem x:Name="Alpha70" Header="70%" IsCheckable="True" Tag="0.70" Click="SetAlpha_Click"/>
                <MenuItem x:Name="Alpha60" Header="60%　最透" IsCheckable="True" Tag="0.60" Click="SetAlpha_Click"/>
            </MenuItem>
            <MenuItem Header="切换移动/锁定" Click="ToggleMove_Click"/>
            <MenuItem Header="退出面板" Click="ExitMenu_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/GlassTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 结束按钮 -->
            <Style x:Key="EndBtn" TargetType="Button">
                <Setter Property="local:RevealBehavior.IsActive" Value="True"/>
                <Setter Property="local:RevealBehavior.CornerRadius" Value="9"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="9" Background="#DC2626">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#EF4444"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#B91C1C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 取消按钮 -->
            <Style x:Key="CancelBtn" TargetType="Button">
                <Setter Property="local:RevealBehavior.IsActive" Value="True"/>
                <Setter Property="local:RevealBehavior.CornerRadius" Value="9"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="9" Background="#9CA3AF">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#AEB6C0"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#868F9C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 扫描按钮（配色随主题） -->
            <Style x:Key="ScanBtn" TargetType="Button">
                <Setter Property="local:RevealBehavior.IsActive" Value="True"/>
                <Setter Property="local:RevealBehavior.CornerRadius" Value="9"/>
                <Setter Property="Foreground" Value="{DynamicResource ScanBtnFgBrush}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="9"
                                    Background="{DynamicResource ScanBtnBgBrush}"
                                    BorderBrush="{DynamicResource ScanBtnBorderBrush}"
                                    BorderThickness="1" Padding="9,4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScanBtnHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScanBtnPressBrush}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#99BFD7F0"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 内存条（配色随主题） -->
            <Style x:Key="GlassMemBar" TargetType="ProgressBar">
                <Setter Property="Height" Value="4"/>
                <Setter Property="Minimum" Value="0"/>
                <Setter Property="Maximum" Value="1"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" CornerRadius="2"
                                        Background="{DynamicResource BarTrackBrush}"/>
                                <Border x:Name="PART_Indicator" CornerRadius="2"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource BarFillBrush}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 子项卡片：四层（填充 / 光带 / 内容 / 独立边框） -->
            <DataTemplate x:Key="ChildTemplate" DataType="{x:Type local:ProcessItem}">
                <Border x:Name="ChildCard" CornerRadius="8" BorderThickness="2"
                        BorderBrush="{DynamicResource ChildBorderBrush}"
                        Background="{DynamicResource ChildBgBrush}" Padding="7,5,7,5" Margin="14,4,0,0"
                        SnapsToDevicePixels="True" SizeChanged="ChildCard_SizeChanged">
                    <Grid ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>

                        <!-- ① 状态色填充层（底层，铺满整个卡片内部） -->
                        <Border x:Name="FillLayer" Grid.RowSpan="2" Grid.ColumnSpan="3" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="CornerRadius" Value="6"/>
                                    <Setter Property="Background" Value="#2E34A853"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsForeground}" Value="False">
                                            <Setter Property="Background" Value="#2EE0A800"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <!-- ② 斜向光带（填充层之上、文字之下） -->
                        <Border x:Name="Shine" Grid.RowSpan="2" Grid.ColumnSpan="3" Width="80"
                                HorizontalAlignment="Left" Opacity="0" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <SkewTransform AngleX="-20"/>
                                    <TranslateTransform x:Name="ShineTranslate" X="-120"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#0034A853" Offset="0"/>
                                                <GradientStop Color="#B334A853" Offset="0.42"/>
                                                <GradientStop Color="#73FFFFFF" Offset="0.55"/>
                                                <GradientStop Color="#0034A853" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsForeground}" Value="False">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#00E0A800" Offset="0"/>
                                                        <GradientStop Color="#B3E0A800" Offset="0.42"/>
                                                        <GradientStop Color="#73FFFFFF" Offset="0.55"/>
                                                        <GradientStop Color="#00E0A800" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <!-- ③ 内容层：名称 + PID -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Display}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="118"
                                       ToolTip="{Binding Display}"/>
                            <TextBlock Text="{Binding PidText}" FontSize="9.5"
                                       Foreground="{DynamicResource TextSubtleBrush}"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>

                        <!-- 内容：内存数值 / 结束确认 -->
                        <Grid Grid.Row="0" Grid.Column="1" MinWidth="54" VerticalAlignment="Center">
                            <TextBlock x:Name="ChildMemText" Text="{Binding MemText}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextValueBrush}"
                                       VerticalAlignment="Center" TextAlignment="Right"
                                       HorizontalAlignment="Right" Margin="0,0,5,0"/>
                            <StackPanel x:Name="ChildConfirmGroup" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Visibility="Collapsed">
                                <Button Content="取消" Width="24" Height="16" Style="{StaticResource CancelBtn}"
                                        Click="CancelEnd_Click" Tag="{Binding}" Margin="0,0,3,0"/>
                                <Button Content="确认" Width="24" Height="16" Style="{StaticResource EndBtn}"
                                        Click="ConfirmEnd_Click" Tag="{Binding}"/>
                            </StackPanel>
                        </Grid>

                        <!-- 操作层：隐藏式结束按钮 -->
                        <Button x:Name="ChildEndBtn" Grid.Row="0" Grid.Column="2" Content="结束"
                                Width="30" Height="16" Style="{StaticResource EndBtn}"
                                Click="End_Click" Tag="{Binding}"
                                Opacity="0" IsHitTestVisible="False"
                                HorizontalAlignment="Right" VerticalAlignment="Center"/>

                        <!-- 内容：子项内存条 -->
                        <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                     Style="{StaticResource GlassMemBar}" Value="{Binding BarRatio}"
                                     Margin="0,4,5,0"/>
                    </Grid>
                </Border>

                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsShining}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard x:Name="ShineStory">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ShineTranslate"
                                                     Storyboard.TargetProperty="X"
                                                     From="-120" To="360" Duration="0:0:0.5">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseInOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="Shine"
                                                     Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:0.06"/>
                                    <DoubleAnimation Storyboard.TargetName="FillLayer"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.3">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <RemoveStoryboard BeginStoryboardName="ShineStory"/>
                        </DataTrigger.ExitActions>
                    </DataTrigger>

                    <!-- 扫光完成：低饱和填充满 + 独立彩色边框常驻（静态，不循环） -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsLit}" Value="True"/>
                            <Condition Binding="{Binding IsForeground}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="ChildCard" Property="BorderBrush" Value="#CC34A853"/>
                        <Setter TargetName="FillLayer" Property="Opacity" Value="1"/>
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsLit}" Value="True"/>
                            <Condition Binding="{Binding IsForeground}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="ChildCard" Property="BorderBrush" Value="#CCE0A800"/>
                        <Setter TargetName="FillLayer" Property="Opacity" Value="1"/>
                    </MultiDataTrigger>

                    <!-- 子项悬停：显现结束按钮 -->
                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=ChildCard}" Value="True">
                        <Setter TargetName="ChildEndBtn" Property="Opacity" Value="1"/>
                        <Setter TargetName="ChildEndBtn" Property="IsHitTestVisible" Value="True"/>
                    </DataTrigger>

                    <DataTrigger Binding="{Binding Confirming}" Value="True">
                        <Setter TargetName="ChildEndBtn" Property="Opacity" Value="0"/>
                        <Setter TargetName="ChildEndBtn" Property="IsHitTestVisible" Value="False"/>
                        <Setter TargetName="ChildMemText" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="ChildConfirmGroup" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- 主程序卡片 -->
            <DataTemplate x:Key="GroupTemplate" DataType="{x:Type local:AppGroup}">
                <Border x:Name="GroupCard" CornerRadius="11" BorderThickness="2"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        Background="Transparent" Padding="9,7,9,7" Margin="0,0,0,5"
                        RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True"
                        MouseEnter="Group_MouseEnter" MouseLeave="Group_MouseLeave"
                        MouseLeftButtonUp="Group_Click"
                        local:RevealBehavior.IsActive="True"
                        local:RevealBehavior.CornerRadius="11">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="GroupScale" ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="打开文件位置" Click="PathMenu_Click" Tag="{Binding}"/>
                        </ContextMenu>
                    </Border.ContextMenu>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="34"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding RankText}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>

                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock Text="{Binding Display}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}"/>
                            <TextBlock Text="{Binding CountText}" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSubtleBrush}"
                                       VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding MemText}"
                                   FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextValueBrush}"
                                   TextAlignment="Right" MinWidth="64" VerticalAlignment="Center"/>

                        <Button x:Name="GroupEndBtn" Grid.Row="0" Grid.Column="3" Content="结束"
                                Width="34" Height="18" Style="{StaticResource EndBtn}"
                                Click="EndGroup_Click" Tag="{Binding}"
                                Opacity="0" IsHitTestVisible="False"
                                HorizontalAlignment="Right" VerticalAlignment="Center"/>

                        <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                     Style="{StaticResource GlassMemBar}" Value="{Binding BarRatio}"
                                     Margin="0,4,0,0"/>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="4">
                            <Border Background="#26DC2626" BorderBrush="#A6DC2626" BorderThickness="1"
                                    CornerRadius="7" Padding="7,5" Margin="0,5,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Confirming}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding ConfirmMessage}" FontSize="10.5" Foreground="#7F1D1D"
                                               TextWrapping="Wrap" Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="取消" Width="42" Height="18" Style="{StaticResource CancelBtn}"
                                                Click="CancelGroup_Click" Tag="{Binding}" Margin="0,0,5,0"/>
                                        <Button Content="确认结束" Width="62" Height="18" Style="{StaticResource EndBtn}"
                                                Click="ConfirmGroup_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <ItemsControl x:Name="ChildrenHost" ItemsSource="{Binding Children}"
                                          ItemTemplate="{StaticResource ChildTemplate}" Margin="0,1,0,0">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <DataTemplate.Triggers>
                    <Trigger SourceName="GroupCard" Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="GroupScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1.02" Duration="0:0:0.12">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="GroupScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1.02" Duration="0:0:0.12">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="GroupScale"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     To="1.0" Duration="0:0:0.14"/>
                                    <DoubleAnimation Storyboard.TargetName="GroupScale"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     To="1.0" Duration="0:0:0.14"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                        <Setter TargetName="GroupCard" Property="Panel.ZIndex" Value="10"/>
                        <Setter TargetName="GroupCard" Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                        <Setter TargetName="GroupEndBtn" Property="Opacity" Value="1"/>
                        <Setter TargetName="GroupEndBtn" Property="IsHitTestVisible" Value="True"/>
                    </Trigger>

                    <!-- 已展开：保持状态边框（已有逻辑，保留） -->
                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                        <Setter TargetName="GroupCard" Property="BorderBrush" Value="#9934A853"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <!-- ===== 面板根容器（固定姿态，不随鼠标倾斜） ===== -->
    <Grid x:Name="TiltRoot" RenderTransformOrigin="0.5,0.5">

        <!-- ========== 材质层 A：白色玻璃（保留，金属主题下隐藏） ========== -->
        <Border x:Name="GlassLayer" CornerRadius="16" SnapsToDevicePixels="True"
                Background="{DynamicResource GlassPanelBrush}"
                BorderBrush="{DynamicResource GlassEdgeOuterBrush}" BorderThickness="1">
            <Border BorderThickness="1" CornerRadius="15"
                    BorderBrush="{DynamicResource GlassEdgeInnerBrush}"
                    Background="{DynamicResource GlassVeilBrush}"/>
        </Border>

        <!-- ========== 材质层 B：深色金属（新增） ========== -->
        <Grid x:Name="MetalLayer" Visibility="Collapsed" IsHitTestVisible="False">
            <!-- 金属底：颜色固定，仅 alpha 由「材质透明度」档位控制 -->
            <Border x:Name="MetalBaseBorder" CornerRadius="16" Background="{DynamicResource MetalBaseBrush}"/>

            <Grid x:Name="MetalClip" ClipToBounds="True" SizeChanged="MetalClip_SizeChanged">
                <Rectangle x:Name="VignetteRect" Fill="{DynamicResource MetalVignetteBrush}"/>

                <Ellipse x:Name="WarmSpot" Width="170" Height="120"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-18,-26,0,0" Fill="{DynamicResource ReflectWarmBrush}">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="WarmOffset"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Ellipse x:Name="CoolSpot" Width="220" Height="150"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-22,-30" Fill="{DynamicResource ReflectCoolBrush}">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="CoolOffset"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Border x:Name="StripLight" Width="185" Height="4"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,-8,0,0" Background="{DynamicResource ReflectStripBrush}"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <RotateTransform Angle="-18"/>
                            <TranslateTransform x:Name="StripOffset"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                </Border>

                <Rectangle x:Name="NoiseLayer" Opacity="0.03" IsHitTestVisible="False"/>
                <!-- 磨砂：对应 liquid-glass blurAmount=0.0625 的极轻白雾 -->
                <Rectangle x:Name="FrostLayer" Fill="#08FFFFFF" IsHitTestVisible="False"/>
            </Grid>

            <!-- 描边只保留同心两层（外缘 16 / 内缘 15）；多半径叠加会在圆角处错位 -->
            <Border CornerRadius="16" BorderThickness="1"
                    BorderBrush="{DynamicResource MetalEdgeOuterBrush}"/>
            <Border CornerRadius="15" BorderThickness="1" Margin="1"
                    BorderBrush="{DynamicResource MetalEdgeInnerBrush}"/>
        </Grid>

        <!-- ========== 内容层（唯一一份，两主题共用） ========== -->
        <Grid Margin="12,8,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource StatusDotIdleBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource StatusDotBusyBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="进程助手" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="扫描" Click="ScanBtn_Click" VerticalAlignment="Center"
                        local:RevealBehavior.IsActive="True" local:RevealBehavior.CornerRadius="9">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ScanBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="Content" Value="扫描中…"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </DockPanel>

            <ScrollViewer x:Name="Scroller" Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          CanContentScroll="True"
                          Focusable="False">
                <ItemsControl x:Name="GroupsList" ItemsSource="{Binding Groups}" Margin="4,0,4,0"
                              ItemTemplate="{StaticResource GroupTemplate}"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="2" Text="{Binding StatusText}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="10.5" FontWeight="Medium" Margin="0,4,0,0"/>
        </Grid>
    </Grid>
</Window>
